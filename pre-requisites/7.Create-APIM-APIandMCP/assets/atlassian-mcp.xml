<policies>
	<inbound>
		<include-fragment fragment-id="atlassian-user-auth" />
		<base />
		<get-authorization-context id="get-atlassian-credential" provider-id="{{atlassian-credential-provider}}" authorization-id="@((string)context.Variables["connectionId"])" context-variable-name="atl" identity-type="managed" ignore-error="false" />
		<set-header name="Authorization" exists-action="override">
			<value>@("Bearer " + ((Authorization)context.Variables["atl"]).AccessToken)</value>
		</set-header>
		<set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
		<set-query-parameter name="subscription-key" exists-action="delete" />
		<set-backend-service base-url="{{atlassian-mcp-base-url}}" />
		<rewrite-uri template="{{atlassian-mcp-path}}" copy-unmatched-params="false" />
	</inbound>
	<backend>
		<base />
	</backend>
	<outbound>
		<base />
		<set-header name="Cache-Control" exists-action="override">
			<value>no-store</value>
		</set-header>
	</outbound>
	<on-error>
		<include-fragment fragment-id="atlassian-safe-errors" />
	</on-error>
</policies>