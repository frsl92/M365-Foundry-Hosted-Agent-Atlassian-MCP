# Shared prerequisite, deployment and post-requisite inputs. Keep real values out of source control.
# Explicit script parameters override saved values. Empty values use script defaults.
# Copy to .env only if it does not exist. Generated outputs are added by scripts,
# below all inputs, grouped by the script that owns them; they are not in this example.
# Run prerequisites, agent deployment, then post-requisites in that order.

# Inputs first used by 1.Register-Atlassian-Client
AZURE_APIM_NAME=""
AZURE_KEY_VAULT_NAME="" #optional
ATLASSIAN_MCP_ENDPOINT=""
ATLASSIAN_MCP_CLIENT_NAME=""
ATLASSIAN_MCP_SECRET_PREFIX="" #for keyvault naming
ATLASSIAN_MCP_SCOPES="read:me read:account offline_access email read:jira:agent-interface write:jira:agent-interface search:jira:agent-interface delete:jira:agent-interface manage:jira:agent-interface read:confluence:agent-interface write:confluence:agent-interface search:confluence:agent-interface search:rovo:agent-interface search:code:agent-interface read:all:twg write:all:twg read:goals:agent-interface write:goals:agent-interface read:projects:agent-interface write:projects:agent-interface read:bitbucket:agent-interface write:bitbucket:agent-interface read:loom:agent-interface write:loom:agent-interface read:talent:agent-interface write:talent:agent-interface read:jira-align:agent-interface write:jira-align:agent-interface read:teams:agent-interface write:teams:agent-interface read:artifacts:agent-interface write:artifacts:agent-interface read:capacity-planning:agent-interface write:capacity-planning:agent-interface read:focus:agent-interface write:focus:agent-interface read:assets:agent-interface write:assets:agent-interface"

# Inputs first used by 2.Configure-APIM-Identity
# Reuses AZURE_APIM_NAME from step 1.
AZURE_RESOURCE_GROUP_NAME=""
AZURE_SUBSCRIPTION_ID=""

# Inputs first used by 3.Configure-APIM-Credential-Provider
# Reuses the APIM target and outputs from steps 1 and 2. Provider defaults to atlassian.
AZURE_APIM_CREDENTIAL_PROVIDER_NAME=""

# Inputs first used by 4.Register-Entra-Applications
# Reuses the APIM name and subscription. Tenant defaults to the APIM identity tenant.
# Names default to <APIM name>-gateway-api and <APIM name>-user-sign-in.
# Redirect defaults to https://token.botframework.com/.auth/web/redirect.
AZURE_TENANT_ID=""
APIM_API_APP_NAME=""
AUTH_APP_NAME=""
AUTH_REDIRECT_URI="https://token.botframework.com/.auth/web/redirect"
# After step 4, manually paste the OAuth sign-in app's client secret Value (not Secret ID).
# Used by post-requisite 1 for Bot OAuth; never generated or printed by prerequisite 4.
AUTH_CLIENT_SECRET=""

# Inputs first used by 5.Configure-APIM-Named-Values
# Reuses the APIM target, managed identity, provider and application/client IDs.
# Policy ARM version defaults to 2022-08-01 (not the script's management API version).
AZURE_APIM_POLICY_ARM_API_VERSION="2022-08-01"
# Backend origin and path default to https://mcp.atlassian.com and /v2/mcp.
# These policy settings do not change the step 1 registration endpoint.
ATLASSIAN_MCP_BASE_URL="" # leave empty to reuse previous values
ATLASSIAN_MCP_PATH="" # leave empty to reuse previous values
# Defaults to https://www.atlassian.com/software/jira.
ATLASSIAN_POST_LOGIN_REDIRECT_URL=""

# Inputs first used by 6.Create-APIM-Fragments
# No new variables; reuses the APIM target and public named values from step 5.
# Fragment identifiers are fixed to the names referenced by the policy assets.

# Inputs first used by 7.Create-APIM-APIandMCP
# Reuses ATLASSIAN_MCP_BASE_URL and ATLASSIAN_MCP_PATH from step 5 for the backend.
# Optional API identifiers and gateway route prefixes (without leading/trailing /).
# Defaults: atlassian-connect for Connect and atlassian-mcp for the external MCP.
AZURE_APIM_CONNECT_API_ID=""
AZURE_APIM_CONNECT_API_PATH=""
AZURE_APIM_MCP_API_ID=""
AZURE_APIM_MCP_API_PATH=""
# The MCP client endpoint is https://<gateway>/<MCP API path>/mcp.
# Both APIs require Ocp-Apim-Subscription-Key plus the supplied user authentication.
# Subscription key values are neither needed for provisioning nor saved by these steps.

# Inputs first used by deployment (agent-deployment/deploy-agent.ps1)
# Required: local azd environment name, existing project's region, ARM ID and endpoint.
# Reuses AZURE_TENANT_ID from prerequisite 4; do not duplicate it here.
# Subscription and resource group for azd are derived from the project ARM ID,
# not the APIM target in prerequisite 2.
AZURE_ENV_NAME="agent-dev"
AZURE_LOCATION=""
AZURE_FOUNDRY_PROJECT_RESOURCE_ID=""
# Endpoint: https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_FOUNDRY_PROJECT_ENDPOINT=""
# Optional: leave empty to discover the bot after deployment; not copied into azd.
# Bot ID: /subscriptions/<id>/resourceGroups/<group>/providers/Microsoft.BotService/botServices/<name>
AZURE_BOT_SERVICE_RESOURCE_ID=""
# Model defaults to gpt-5.6-luna when empty. Use your gateway model deployment name.
FOUNDRY_MODEL_NAME="gpt-5.6-luna"
# Required model gateway endpoint and subscription key.
GATEWAY_MODELS_ENDPOINT=""
GATEWAY_SUBSCRIPTION_KEY=""
# Reuses AZURE_APIM_MCP_SERVER_URL and AZURE_APIM_CONNECT_STATUS_URL generated by step 7.
# Optional keys are sent as Ocp-Apim-Subscription-Key by the agent.
# Empty keys are injected as empty strings; the APIM APIs still require valid keys.
APIM_STATUS_SUBSCRIPTION_KEY=""
APIM_MCP_SUBSCRIPTION_KEY=""
# Required connection name for the agent's APIM user-authorization handler.
# Used by post-requisite 1 for Bot Service OAuth; deployment does not create it.
AZURE_BOT_SERVICE_OAUTH_CONNECTION_NAME=""
# Agent name comes from services.agent.name in agent-deployment/azure.yaml.
# Deployment saves AZURE_FOUNDRY_AGENT_NAME as a generated output, not a user input.

# Inputs first used by post-requisite 1.Configure-Bot-OAuth
# No new variables; reuses the deployment endpoint, agent name, verified bot ID
# and AZURE_BOT_SERVICE_OAUTH_CONNECTION_NAME, plus AZURE_TENANT_ID,
# AUTH_CLIENT_ID, AUTH_CLIENT_SECRET and APIM_SCOPE from prerequisite 4.
# Scopes: openid profile offline_access <APIM_SCOPE>. Token Exchange URL is empty.
# For an externally deployed agent, set those target values in .env manually.

# Inputs first used by post-requisite 2.Configure-M365-Endpoint
# No new variables; reuses the post-requisite 1 target.

# Inputs first used by post-requisite 3.Prepare-Teams-Package
# No root variables; runs offline using the azd source ZIP and metadata JSON.
# Supply -MetadataFile; package paths are parameters. No automatic publishing.
# Versioned ZIPs are saved beside step 3 for manual Teams admin center upload.
